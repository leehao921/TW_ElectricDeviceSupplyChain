<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.lulala.ddr-price</string>

    <!-- DDR 現貨價日更 (Mon-Fri 08:20, memory-cycle 08:40 之前):
         抓 DRAMeXchange 首頁現貨表 → data/ddr_price_history.json +
         自動重寫 memory_cycle_inputs.yaml 的 ddr4 月均 series。
         inbox topic=ddr-price。Single-shot per fire — no KeepAlive. -->

    <key>ProgramArguments</key>
    <array>
        <string>/Users/lulala/Documents/coding/My-TW-Coverage/.venv/bin/python</string>
        <string>/Users/lulala/Documents/coding/My-TW-Coverage/scripts/ddr_price_daily.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/lulala/Documents/coding/My-TW-Coverage</string>

    <key>RunAtLoad</key>
    <false/>

    <!-- Mon-Fri 19:30 local time (Asia/Taipei). -->
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>8</integer><key>Minute</key><integer>20</integer></dict>
        <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>8</integer><key>Minute</key><integer>20</integer></dict>
        <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>8</integer><key>Minute</key><integer>20</integer></dict>
        <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>8</integer><key>Minute</key><integer>20</integer></dict>
        <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>8</integer><key>Minute</key><integer>20</integer></dict>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>TZ</key><string>Asia/Taipei</string>
        <key>PATH</key><string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>REDIS_HOST</key><string>localhost</string>
        <key>REDIS_PORT</key><string>6379</string>
        <key>DB_HOST</key><string>localhost</string>
        <key>DB_PORT</key><string>5432</string>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/lulala/Library/Logs/ddr-price.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/lulala/Library/Logs/ddr-price.log</string>
</dict>
</plist>
