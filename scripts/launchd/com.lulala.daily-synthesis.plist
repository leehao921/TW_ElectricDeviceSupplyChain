<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.lulala.daily-synthesis</string>

    <!-- 每交易日 15:50 (bb-followthrough 15:30 之後) 跑 headless Claude 綜合分析:
         讀 inbox + 各 routine log + memory-cycle/ETF 最新報告, 產
         analysis/routine_synthesis_<date>.md, XADD claude:inbox topic=routine-synthesis,
         發 macOS 通知。單次執行, 無 KeepAlive。 -->

    <!-- 必須用 .venv/bin/python 直接執行 (有 TCC ~/Documents 授權);
         /bin/bash 會 Operation not permitted (2026-07-16 實測 exit 126)。 -->
    <key>ProgramArguments</key>
    <array>
        <string>/Users/lulala/Documents/coding/My-TW-Coverage/.venv/bin/python</string>
        <string>/Users/lulala/Documents/coding/My-TW-Coverage/scripts/daily_synthesis.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/lulala/Documents/coding/My-TW-Coverage</string>

    <key>RunAtLoad</key>
    <false/>

    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>15</integer><key>Minute</key><integer>50</integer></dict>
        <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>15</integer><key>Minute</key><integer>50</integer></dict>
        <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>15</integer><key>Minute</key><integer>50</integer></dict>
        <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>15</integer><key>Minute</key><integer>50</integer></dict>
        <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>15</integer><key>Minute</key><integer>50</integer></dict>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>TZ</key><string>Asia/Taipei</string>
        <key>PATH</key><string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>REDIS_HOST</key><string>localhost</string>
        <key>REDIS_PORT</key><string>6379</string>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/lulala/Library/Logs/daily-synthesis.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/lulala/Library/Logs/daily-synthesis.log</string>
</dict>
</plist>
