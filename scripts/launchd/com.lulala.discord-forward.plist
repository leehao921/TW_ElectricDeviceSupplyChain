<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.lulala.discord-forward</string>

    <!-- claude:inbox → Discord webhook forwarder,常駐 daemon (XREAD BLOCK 5s,即時)。
         Cursor 存 Redis discord:forward:last_id;健康 hash discord:forward:health
         (routine-watchdog 監看 heartbeat,>10 分鐘停擺 → macOS 通知)。
         Webhook:DISCORD_WEBHOOK_URL_{TRADING,REPORTS,SYSTEM} 未設 → fallback
         DISCORD_WEBHOOK_URL (env 或 ../database/.env)。venv python 直跑 (TCC:不可經 bash)。
         重載:launchctl bootout gui/$UID/com.lulala.discord-forward;
               launchctl bootstrap gui/$UID <plist>  (勿用 kickstart -k)
         Plans: docs/plans/2026-07-30-discord-push.md,
                docs/plans/2026-10-06-discord-forward-realtime.md -->

    <key>ProgramArguments</key>
    <array>
        <string>/Users/lulala/Documents/coding/My-TW-Coverage/.venv/bin/python</string>
        <string>/Users/lulala/Documents/coding/My-TW-Coverage/scripts/discord_forward.py</string>
        <string>--daemon</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/lulala/Documents/coding/My-TW-Coverage</string>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <!-- 崩潰後重啟最短間隔 (秒),避免 crash loop 洗 log -->
    <key>ThrottleInterval</key>
    <integer>30</integer>

    <key>EnvironmentVariables</key>
    <dict>
        <key>TZ</key><string>Asia/Taipei</string>
        <key>PATH</key><string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>REDIS_HOST</key><string>localhost</string>
        <key>REDIS_PORT</key><string>6379</string>
        <key>PYTHONUNBUFFERED</key><string>1</string>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/lulala/Library/Logs/discord-forward.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/lulala/Library/Logs/discord-forward.log</string>
</dict>
</plist>
