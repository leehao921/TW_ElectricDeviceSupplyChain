<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.lulala.foreign-structure</string>

    <!-- 外資結構背離 foreign_structure (Mon-Fri 17:10 Asia/Taipei,
         期貨 OI collector 17:00 落地後): 現貨 5D 淨買金額 z vs TXF 淨 OI z →
         hedged_accumulation / distribution_cover 分類,
         analysis/foreign_structure_<date>.md + inbox topic=foreign-structure。
         Single-shot per fire — no KeepAlive. -->

    <key>ProgramArguments</key>
    <array>
        <string>/Users/lulala/Documents/coding/My-TW-Coverage/.venv/bin/python</string>
        <string>/Users/lulala/Documents/coding/My-TW-Coverage/scripts/foreign_structure.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/lulala/Documents/coding/My-TW-Coverage</string>

    <key>RunAtLoad</key>
    <false/>

    <!-- Mon-Fri 19:30 local time (Asia/Taipei). -->
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>17</integer><key>Minute</key><integer>10</integer></dict>
        <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>17</integer><key>Minute</key><integer>10</integer></dict>
        <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>17</integer><key>Minute</key><integer>10</integer></dict>
        <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>17</integer><key>Minute</key><integer>10</integer></dict>
        <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>17</integer><key>Minute</key><integer>10</integer></dict>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>TZ</key><string>Asia/Taipei</string>
        <key>PATH</key><string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>REDIS_HOST</key><string>localhost</string>
        <key>REDIS_PORT</key><string>6379</string>
        <key>DB_HOST</key><string>localhost</string>
        <key>DB_PORT</key><string>5432</string>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/lulala/Library/Logs/foreign-structure.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/lulala/Library/Logs/foreign-structure.log</string>
</dict>
</plist>
